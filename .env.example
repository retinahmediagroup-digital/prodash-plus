# Copy to .env (git-ignored) and fill in. Never commit real values.
# Web app settings live separately in web/.env.local.

# Postgres for notebooks and pipeline jobs: Supabase dashboard > Connect > Session pooler (port 5432).
# User is etl_worker.<project_ref>; the password is the one set for etl_worker (sql/13_etl_role.sql).
PRODASH_DB_URL=postgresql://etl_worker.mxcadrfzjamyllfbvnrb:<password>@<session-pooler-host>:5432/postgres

# Storage access for original CSV files: Settings > API Keys > secret key (sb_secret_...).
# A legacy service_role key also works, but Supabase retires legacy keys at the end of 2026.
SUPABASE_URL=https://mxcadrfzjamyllfbvnrb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PRODASH_CLIENT_ID=PRODAIRY
PRODASH_BUCKET=raw-uploads
